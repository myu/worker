{
  "name": "@product-video/media-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "docker:build": "docker buildx build --platform linux/amd64 --load -t product-video-media-worker:local .",
    "docker:check": "docker run --rm product-video-media-worker:local check"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@supabase/supabase-js": "^2.57.4"
  }
}
